rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "ib.karakaya@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMemberOfGroup(groupId) {
      return isSignedIn() && (isAdmin() || (exists(/databases/$(database)/documents/groups/$(groupId)) &&
             request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members));
    }

    // Groups
    match /groups/{groupId} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.members) && isValidId(groupId);
      allow list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && 
                    isValidId(groupId) &&
                    incoming().id == groupId &&
                    incoming().ownerId == request.auth.uid &&
                    incoming().members.size() >= 1 &&
                    incoming().members[0] == request.auth.uid;
      allow update: if isSignedIn() &&
                    isValidId(groupId) &&
                    (isAdmin() || request.auth.uid == existing().ownerId) &&
                    incoming().id == existing().id &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'members']);
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == existing().ownerId) && isValidId(groupId);
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.memberUids) && isValidId(taskId);
      allow list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn() &&
                    isValidId(taskId) &&
                    isMemberOfGroup(incoming().groupId) &&
                    incoming().id == taskId &&
                    (isAdmin() || request.auth.uid in incoming().memberUids) &&
                    incoming().createdBy == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
                    isValidId(taskId) &&
                    (isAdmin() || (request.auth.uid in existing().memberUids && request.auth.uid in incoming().memberUids)) &&
                    incoming().id == existing().id &&
                    incoming().groupId == existing().groupId &&
                    incoming().createdBy == existing().createdBy &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid in existing().memberUids) && isValidId(taskId);
    }
  }
}
