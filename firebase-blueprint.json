{
  "entities": {
    "Receipt": {
      "title": "Receipt",
      "description": "A receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendor": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "tax": { "type": "number" },
        "items": { "type": "array" },
        "driveUrl": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "vendor", "date", "total", "userId"]
    }
  },
  "firestore": {
    "/receipts/{receiptId}": {
      "schema": { "$ref": "Receipt" },
      "description": "Receipts collection"
    }
  }
}
