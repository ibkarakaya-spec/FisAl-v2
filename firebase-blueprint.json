{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with household association",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "householdId": { "type": "string" }
      },
      "required": ["email", "householdId"]
    },
    "Household": {
      "title": "Household",
      "description": "Shared group for receipts and budgets",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "categories": { "type": "array" }
      },
      "required": ["ownerId", "categories"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Expense receipt data",
      "type": "object",
      "properties": {
        "vendor": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "tax": { "type": "number" },
        "items": { "type": "array" },
        "confidence": { "type": "number" },
        "timestamp": { "type": "number" },
        "imageUrl": { "type": "string" },
        "createdBy": { "type": "string" }
      }
    },
    "BudgetLimit": {
      "title": "BudgetLimit",
      "description": "Budget limit for a category in a specific month",
      "type": "object",
      "properties": {
        "month": { "type": "string" },
        "category": { "type": "string" },
        "limit": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user records"
    },
    "/households/{householdId}": {
      "schema": "Household",
      "description": "Shared household settings"
    },
    "/households/{householdId}/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "Household shared receipts"
    },
    "/households/{householdId}/limits/{limitId}": {
      "schema": "BudgetLimit",
      "description": "Household budget limits"
    }
  }
}
